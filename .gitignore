# Log files
*.log

# Temporary files
*.tmp
*.temp

# Root package-lock.json (generated accidentally — no root package.json)
/package-lock.json

# Root node_modules and Vite cache (accidentally generated by npx from root)
/node_modules/
/.vite/

# VS Code workspace settings (machine-local paths)
.vscode/
*.code-workspace
# OS
Thumbs.db
.DS_Store

# Streamlit secrets (local, never commit)
/.streamlit/secrets.toml
